<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>DuckWorkshopSetup</AssemblyName>
    <RootNamespace>DuckWorkshop.Setup</RootNamespace>
    <Version>0.3.3</Version>
    <Product>Duck Workshop Setup</Product>
    <ApplicationIcon>../assets/duck-workshop.ico</ApplicationIcon>
    <StartupObject>DuckWorkshop.Setup.Program</StartupObject>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../assets/duck-workshop.png" Link="Logo.png" />
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="DuckWorkshop.Payload.zip" Condition="Exists('$(PayloadPath)')" />
    <EmbeddedResource Include="$(PayloadMetadataPath)" LogicalName="DuckWorkshop.Payload.json" Condition="Exists('$(PayloadMetadataPath)')" />
  </ItemGroup>
</Project>
